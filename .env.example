# Copy to .env.development.local (git-ignored via *.local) for local work.
# Point it at a LOCAL (`supabase start`) or STAGING project — never production.
#
# Production values are configured in the hosting provider (Vercel) project
# settings, not in this repository.

# Supabase project reference (the subdomain of the project URL)
VITE_SUPABASE_PROJECT_ID="your-staging-project-ref"

# Public API URL, e.g. https://<ref>.supabase.co or http://127.0.0.1:54321 for `supabase start`
VITE_SUPABASE_URL="https://your-staging-project-ref.supabase.co"

# Publishable / anon key (public by design; protected by RLS). NEVER put the service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY="your-staging-anon-or-publishable-key"

# Monitoring (free, self-owned): "staging" or "production" turns on error and
# Web Vitals reporting to this project's report_client_error / report_web_vital.
# Leave unset locally.
VITE_APP_ENV=""
